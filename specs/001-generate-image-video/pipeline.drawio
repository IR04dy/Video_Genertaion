        <mxCell id="e5" value="measured seconds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=3;fontSize=11;" edge="1" parent="1" source="vOut" target="bMeasure">
          <mxGeometry relative="1" as="geometry" />
