<mxfile host="app.diagrams.net" modified="2026-09-02T00:00:00.000Z" agent="Claude" version="24.0.0" type="device">
  <diagram id="vg-pipeline" name="Generation pipeline">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Video generation pipeline &#8212; measured 2026-09-01/02 on RTX 5080 (16 GiB) / 64 GiB RAM" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Voice runs in-process; video runs in a separate venv driven over HTTP. The split is forced by a dependency conflict, not by preference." style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1100" height="20" as="geometry" />
        </mxCell>

        <mxCell id="inputsBox" value="1 &#183; INPUTS (validated, staged, consent-bound)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;fontStyle=1;fontSize=12;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1560" height="110" as="geometry" />
        </mxCell>
        <mxCell id="inImg" value="Portrait image(s)&#10;&#10;1+ images, exactly one face each&#10;centre-crop to target aspect, never stretch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="250" height="66" as="geometry" />
        </mxCell>
        <mxCell id="inVoice" value="Reference voice WAV&#10;&#10;10&#8211;30 s, mono, clean, normalised&#10;consent attestation bound to SHA-256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="330" y="120" width="250" height="66" as="geometry" />
        </mxCell>
        <mxCell id="inScript" value="Speech script (Arabic)&#10;&#10;never truncated, never reordered&#10;dialect comes from the reference voice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="600" y="120" width="250" height="66" as="geometry" />
        </mxCell>
        <mxCell id="inPrompt" value="Motion prompt + negative&#10;&#10;camera / lighting / movement&#10;truncation recorded as an override" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="870" y="120" width="250" height="66" as="geometry" />
        </mxCell>
        <mxCell id="inSeed" value="Seed / duration override&#10;&#10;duration is advisory only&#10;the measured waveform decides" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1140" y="120" width="250" height="66" as="geometry" />
        </mxCell>

        <mxCell id="voiceBox" value="2 &#183; VOICE &#8212; app venv, in-process&#160;&#160;(XTTS-v2 via coqui-tts 0.27.5, CPML: non-commercial)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=12;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="760" height="230" as="geometry" />
        </mxCell>
        <mxCell id="vSplit" value="Split script at the Arabic limit&#10;&#10;char_limits[&quot;ar&quot;] = 166&#10;pysbd sentence boundaries first,&#10;hard split only if a sentence exceeds it&#10;XTTS TRUNCATES silently &#8212; splitting is mandatory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="vSynth" value="Synthesize per segment, then concatenate&#10;&#10;24 kHz mono &#183; 0.25&#215; realtime &#183; 2.69 GiB VRAM&#10;voice identity + dialect come from the reference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="420" y="270" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="vOut" value="speech.wav &#8212; the authoritative timebase" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b9e0a5;strokeColor=#82b366;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="386" width="720" height="46" as="geometry" />
        </mxCell>

        <mxCell id="bridgeBox" value="3 &#183; TIMEBASE BRIDGE &#8212; pure function, no model" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;fontSize=12;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="830" y="230" width="770" height="230" as="geometry" />
        </mxCell>
        <mxCell id="bMeasure" value="Measure the waveform&#10;&#10;duration is MEASURED, never estimated.&#10;This is what removed the old drift:&#10;video is generated TO the audio." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="850" y="270" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="bFrames" value="Frames = 4n+1 grid&#10;&#10;ceil(seconds &#215; 16 fps), rounded UP&#10;to the next legal 4n+1&#10;(81 frames = 5.0 s)&#10;Round up, never down: down truncates speech." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1110" y="270" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="bResample" value="Condition-rate copy&#10;&#10;resample to 16 kHz for the audio encoder;&#10;keep 24 kHz for delivery.&#10;Pad the tail to the frame grid." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1370" y="270" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="bNote" value="Long-form: if measured speech exceeds the practical clip ceiling, chunk and stitch via WanSoundImageToVideoExtend. Ceiling UNMEASURED." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="850" y="386" width="730" height="46" as="geometry" />
        </mxCell>

        <mxCell id="procBoundary" value="PROCESS BOUNDARY &#8212; separate venv, driven over HTTP (127.0.0.1:8188).&#160;&#160;Forced: ComfyUI needs transformers 5.16.1; the app is capped at 4.57.1 by XTTS. They cannot share an environment." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;align=left;spacingLeft=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="1560" height="44" as="geometry" />
        </mxCell>

        <mxCell id="videoBox" value="4 &#183; VIDEO &#8212; ComfyUI subprocess&#160;&#160;(native Wan S2V nodes, Apache-2.0 weights)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;fontSize=12;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1560" height="290" as="geometry" />
        </mxCell>

        <mxCell id="mDit" value="UNETLoader&#10;wan2.2_s2v_14B_fp8_scaled&#10;15.27 GiB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mClip" value="CLIPLoader (umt5)&#10;umt5_xxl_fp8_e4m3fn_scaled&#10;6.27 GiB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="260" y="600" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mVae" value="VAELoader&#10;wan_2.1_vae&#10;0.24 GiB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="600" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mAud" value="AudioEncoderLoader&#10;wav2vec2_large_english_fp16&#10;0.59 GiB &#8212; ENGLISH encoder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="600" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="nEnc" value="AudioEncoderEncode&#10;(16 kHz speech &#8594; features)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0e6f6;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="690" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="nTxt" value="CLIPTextEncode &#215;2&#10;positive / negative" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0e6f6;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="260" y="690" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="nS2V" value="WanSoundImageToVideo&#10;width / height / length (step = 4)&#10;+ ref_image&#160;&#160;&#8594; conditioning + latent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0b3e0;strokeColor=#9673a6;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="880" y="600" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nSampler" value="KSampler&#10;uni_pc / simple &#183; cfg 6.0&#10;MEASURED: 3.8 s/step&#10;(33 frames @ 320&#215;576, 8 steps = 30 s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0b3e0;strokeColor=#9673a6;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1150" y="600" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nDec" value="VAEDecode&#10;latent &#8594; frames" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0e6f6;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1410" y="600" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nWhy" value="Why ComfyUI and not DiffSynth: async weight offloading with 2 streams + pinned memory (36.8 GB/s measured).&#10;DiffSynth 2.1.5 used pageable memory in a single-threaded loop &#8212; one CPU core saturated, GPU starved at 61 W,&#10;&gt;1200 s/step across six configurations. Same weights, same card: ~300&#215; difference." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="760" width="770" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nRisk" value="OPEN RISK: the audio encoder is English-trained but drives Arabic.&#10;It conditions on phonetic features so it usually transfers &#8212; but if Arabic&#10;lip sync is wrong, this is the first suspect, not the video model." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="880" y="760" width="700" height="70" as="geometry" />
        </mxCell>

        <mxCell id="outBox" value="5 &#183; EXPORT, VERIFY, PUBLISH &#8212; app venv" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=12;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="1560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="oMux" value="Mux&#10;frames + speech.wav&#10;&#8594; output.mp4 @ 16 fps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="920" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="oVerify" value="Verify&#10;both streams present, non-silent&#10;durations agree within one frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="310" y="920" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="oManifest" value="Manifest&#10;request.json, digest per artifact,&#10;derived-voice.json provenance&#10;(no licence field, by design)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="920" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="oPublish" value="Publish atomically&#10;outputs/&lt;request-id&gt;/&#10;staged in outputs/.work/&lt;id&gt;, then renamed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="920" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="oFinal" value="output.mp4&#10;+ frames.mp4, speech.wav,&#10;prompt.txt, request.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b9e0a5;strokeColor=#82b366;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1150" y="920" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="oGuard" value="GUARD&#10;assert zero network&#10;calls during inference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1400" y="920" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="inVoice" target="vSynth">
          <mxGeometry relative="1" as="geometry" />
