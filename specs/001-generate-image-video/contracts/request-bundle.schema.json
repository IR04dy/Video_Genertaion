{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.image-text-to-video/schemas/request-bundle.json",
  "title": "RequestBundleManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "state",
    "created_at",
    "completed_at",
    "bundle_relative_path",
    "artifacts",
    "voice_origin",
    "consent",
    "language",
    "models",
    "parameters",
    "memory_by_stage",
    "plaintext_sensitive_artifacts",
    "disk_bytes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "format": "uuid"},
    "state": {"const": "complete"},
    "created_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "bundle_relative_path": {
      "type": "string",
      "pattern": "^outputs/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact"},
      "allOf": [
        {"contains": {"properties": {"kind": {"const": "original_image"}}, "required": ["kind"]}, "minContains": 1},
        {"contains": {"properties": {"kind": {"const": "reference_audio"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "derived_voice"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "assembled_prompt"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "decoded_video"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "decoded_audio"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "final_mp4"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "metadata"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "voice_origin": {
      "anyOf": [
        {"$ref": "#/$defs/voiceOrigin"},
        {"type": "null"}
      ]
    },
    "consent": {"$ref": "#/$defs/consent"},
    "language": {"type": "string", "minLength": 1, "maxLength": 80},
    "models": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/effectiveModel"},
      "allOf": [
        {"contains": {"properties": {"role": {"const": "video"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"role": {"const": "voice"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"role": {"const": "lip_sync"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "parameters": {"$ref": "#/$defs/parameters"},
    "memory_by_stage": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/memorySnapshot"}
    },
    "plaintext_sensitive_artifacts": {"const": true},
    "disk_bytes": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "relative_path", "media_type", "size_bytes", "sha256", "created_by_stage"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "original_image",
            "reference_audio",
            "derived_voice",
            "assembled_prompt",
            "decoded_video",
            "decoded_audio",
            "final_mp4",
            "metadata"
          ]
        },
        "relative_path": {"$ref": "#/$defs/relativePath"},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 120},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "created_by_stage": {
          "type": "string",
          "enum": ["validate", "prepare_references", "assemble_prompt", "plan_duration", "load_model", "generate", "decode", "export", "verify", "metadata", "publish"]
        }
      }
    },
    "voiceOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_id", "artifact_relative_path", "artifact_sha256"],
      "properties": {
        "bundle_id": {"type": "string", "format": "uuid"},
        "artifact_relative_path": {"$ref": "#/$defs/relativePath"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "reference_audio_sha256", "confirmed", "confirmed_at"],
      "properties": {
        "request_id": {"type": "string", "format": "uuid"},
        "reference_audio_sha256": {"$ref": "#/$defs/sha256"},
        "confirmed": {"const": true},
        "confirmed_at": {"type": "string", "format": "date-time"}
      }
    },
    "effectiveModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "provider_mode", "repo_id", "commit", "adapter_key"],
      "properties": {
        "role": {"type": "string", "enum": ["video", "voice", "lip_sync"]},
        "provider_mode": {"type": "string", "enum": ["native", "dedicated"]},
        "repo_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "commit": {"type": "string", "pattern": "^[A-Fa-f0-9]{40}$"},
        "adapter_key": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effective_seed",
        "profile_id",
        "suggested_duration_seconds",
        "operator_overrode_duration",
        "effective_duration_seconds",
        "effective_num_frames",
        "frame_rate",
        "resolution",
        "audio_sample_rate",
        "prompt_token_count",
        "prompt_token_capacity",
        "offload_mode",
        "runtime_profile"
      ],
      "properties": {
        "effective_seed": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "suggested_duration_seconds": {"type": "number", "exclusiveMinimum": 0, "description": "Derived from trimmed script length and the profile's per-language speaking rate, clamped to the profile's supported range."},
        "speaking_rate_used": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["language", "rate"],
          "description": "Profile speaking-rate entry the suggestion came from; null when the selected language has no entry and the profile default was offered instead.",
          "properties": {
            "language": {"type": "string", "minLength": 1, "maxLength": 80},
            "rate": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "preferred_duration_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0, "description": "Operator override, when supplied."},
        "operator_overrode_duration": {"type": "boolean", "description": "Whether the operator changed the suggested duration."},
        "profile_id": {"type": "string", "minLength": 1, "maxLength": 200, "description": "Adapter profile identity and revision every measured value below was read from."},
        "effective_duration_seconds": {"type": "number", "exclusiveMinimum": 0, "description": "From the profile's measured supported range; no bound is fixed by this schema."},
        "effective_num_frames": {"type": "integer", "minimum": 1},
        "frame_rate": {"type": "number", "exclusiveMinimum": 0, "description": "Measured profile value, not an application constant."},
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1}
          }
        },
        "audio_sample_rate": {"type": "integer", "minimum": 1},
        "audio_channels": {"type": ["integer", "null"], "minimum": 1},
        "prompt_token_count": {"type": "integer", "minimum": 0},
        "prompt_token_capacity": {"type": "integer", "minimum": 1},
        "offload_mode": {"type": "string", "enum": ["none", "model_cpu", "sequential_cpu", "layer_wise"]},
        "quantization": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
        "guidance_scale": {"type": ["number", "null"]},
        "motion_prompt_truncation": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["original_length", "retained_length", "discarded_length"],
          "properties": {
            "original_length": {"type": "integer", "minimum": 0},
            "retained_length": {"type": "integer", "minimum": 0},
            "discarded_length": {"type": "integer", "minimum": 0}
          }
        },
        "runtime_profile": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "memorySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available"],
      "properties": {
        "available": {"type": "boolean"},
        "device_name": {"type": ["string", "null"], "maxLength": 200},
        "allocated_bytes": {"type": ["integer", "null"], "minimum": 0},
        "reserved_bytes": {"type": ["integer", "null"], "minimum": 0},
        "peak_allocated_bytes": {"type": ["integer", "null"], "minimum": 0},
        "peak_reserved_bytes": {"type": ["integer", "null"], "minimum": 0},
        "free_bytes": {"type": ["integer", "null"], "minimum": 0},
        "total_bytes": {"type": ["integer", "null"], "minimum": 0},
        "reserved_gate_passed": {"type": ["boolean", "null"]},
        "unavailable_reason": {"type": ["string", "null"], "maxLength": 300}
      }
    }
  }
}
