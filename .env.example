# Non-secret runtime options. Copy to `.env` and edit as needed.
# Every value here has a working default; the file exists to document the knobs.
#
# NOT configurable, deliberately:
#   * the bundle root. Successful outputs always publish to `outputs/<request-id>`
#     and staging always lives in `outputs/.work/<request-id>`. No override exists,
#     because a redirectable output root is a path-containment hole.
#   * the model cache root, fixed at `.model-cache/`.
#   * any Hugging Face token. The application never reads or stores one.

# --- Server ---
# Loopback only. The app never enables Gradio sharing.
APP_BIND_HOST=127.0.0.1
APP_BIND_PORT=7860

# --- Disk ---
# Free space that must remain after a download or a generation completes.
# Checked at preflight and monitored during every write stage. Bytes.
APP_DISK_RESERVE_BYTES=10737418240   # 10 GiB

# --- Resource ceilings ---
# Both gate profile selection. A profile breaching either one is not selectable.
#
# Accelerator ceiling, measured as peak allocator-RESERVED bytes (not allocated).
APP_MAX_RESERVED_BYTES=14495514624   # 13.5 GiB
#
# Host system-memory ceiling, measured as resident set size. Layer-wise offload
# keeps the model resident in host RAM and streams it to the card, so this is a
# first-class budget rather than an incidental one.
APP_MAX_HOST_RESIDENT_BYTES=68719476736   # 64 GiB

# --- Runtime profile ---
# Selects a declared memory/device profile by name. Offload mode and quantization
# are read from the profile, never discovered at run time.
APP_RUNTIME_PROFILE=default

# --- Cancellation ---
# Grace period a cancelled stage is given to release resources and remove its
# staging directory before the reclaim is forced. Seconds.
#
# This bounds CLEANUP only. It is NOT an inference timeout: generation itself is
# unbounded by decision and is never cancelled on elapsed time.
APP_CANCELLATION_GRACE_SECONDS=30
